[Unit]
Description=CubeSat MAVLink telemetry sender
After=multi-user.target

[Service]
Type=simple
User=jih
WorkingDirectory=/home/jih/cubesat
Environment=MAV_LORA_DEVICE=off
ExecStart=/home/jih/cubesat/mavenv/bin/python -u /home/jih/cubesat/ELRS/mav.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
