[Unit]
Description=CubeSat MAVLink telemetry test sender
After=multi-user.target

[Service]
Type=simple
User=cubesat
WorkingDirectory=/home/cubesat/cubesat
ExecStart=/home/cubesat/cubesat/mavenv/bin/python -u /home/cubesat/cubesat/mav_test.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
